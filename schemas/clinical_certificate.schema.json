{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinvectum.com/clinical-ai-eval/clinical_certificate.schema.json",
  "title": "Clinical Decision Certificate (v0.6)",
  "$comment": "severity and certificate_effect are SEPARATE required closed enums. severity is clinical importance and NEVER decides the verdict; certificate_effect (block|defer) decides it. The verifier ALSO fails closed on unrecognized values, so this schema is defence-in-depth, not the only gate. Conflating the two axes is what allowed a present contraindication to certify when severity was spelled 'high'.",
  "type": "object",
  "required": [
    "certificate_id",
    "patient_snapshot",
    "evidence_bundle",
    "action",
    "support",
    "critical_questions",
    "contraindications"
  ],
  "properties": {
    "certificate_id": { "type": "string", "minLength": 1 },
    "claimed_verdict": {
      "enum": ["CERTIFIED_CONDITIONAL", "DEFER", "BLOCK"],
      "description": "Optional self-claim. The verifier's computed verdict is authoritative; a mismatch is reported."
    },
    "patient_snapshot": {
      "type": "object",
      "required": ["captured_at", "facts"],
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "facts": { "type": "object" }
      },
      "additionalProperties": true
    },
    "evidence_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "valid", "inactive", "expired", "superseded"] },
          "jurisdiction": { "type": "string" },
          "retrieved_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "action": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "dose": { "type": "string" },
        "route": { "type": "string" },
        "frequency": { "type": "string" },
        "duration": { "type": "string" }
      },
      "additionalProperties": true
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "applicable"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "applicable": { "type": "boolean" },
          "conflict": { "type": "boolean" },
          "provenance": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "critical_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/check_cq" }
    },
    "contraindications": {
      "type": "array",
      "items": { "$ref": "#/$defs/check_contra" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "severity": {
      "enum": ["critical", "high", "moderate", "low"],
      "description": "Clinical importance. Aligned with this repository's vocabulary. NEVER decides the verdict and MUST NOT be used to silence a check."
    },
    "certificate_effect": {
      "enum": ["block", "defer"],
      "description": "What a failed/unknown result does to the verdict. This is the ONLY field that decides verdict semantics."
    },
    "check_cq": {
      "type": "object",
      "required": ["id", "status", "severity", "certificate_effect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "status": { "enum": ["pass", "fail", "unknown", "not_applicable"] },
        "severity": { "$ref": "#/$defs/severity" },
        "certificate_effect": { "$ref": "#/$defs/certificate_effect" },
        "determining": {
          "type": "boolean",
          "description": "Whether resolving this question can change the verdict (feeds the minimum-information solver)."
        },
        "provenance": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": true
    },
    "check_contra": {
      "type": "object",
      "required": ["id", "status", "severity", "certificate_effect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "status": { "enum": ["present", "absent", "unknown", "not_applicable"] },
        "severity": { "$ref": "#/$defs/severity" },
        "certificate_effect": { "$ref": "#/$defs/certificate_effect" },
        "provenance": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": true
    }
  }
}
