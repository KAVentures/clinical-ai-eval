# Copy only to an approved root-managed configuration path.
# Do not store gateway secrets in this file or the clinical workspace.
CAEVAL_AUTH_MODE=gateway
CAEVAL_WORKSPACE=/srv/caeval/workspace
CAEVAL_HTTPS_ORIGIN=https://clinical.example.org
CAEVAL_FEDERATION_ISSUER=https://id.example.org/tenant
CAEVAL_PROXY_SECRET_FILE=/etc/caeval/gateway.key
